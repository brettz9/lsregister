{
  "name": "lsregister",
  "version": "1.0.0",
  "description": "Interact with Launch Services database",
  "main": "./dist/index.cjs",
  "type": "module",
  "types": "./dist/index.d.cts",
  "exports": {
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "scripts": {
    "sample": "node sample",
    "tsc": "tsc",
    "attw": "attw --pack",
    "lint": "eslint .",
    "test": "echo 'tests not available'",
    "prebuild": "npm run lint && npm test && rimraf dist",
    "build": "rollup -c && tsc",
    "prepare": "npm run build"
  },
  "keywords": [
    "system",
    "MacOS"
  ],
  "author": "rogerbf <roger@bergfalk.nu> (http://bergfalk.nu/)",
  "contributors": [
    "Brett Zamir"
  ],
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "rimraf": "6.1.2",
    "rollup": "^4.53.3",
    "typescript": "^5.9.3"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "eslintConfig": {
    "env": {
      "node": true
    },
    "parserOptions": {
      "ecmaVersion": 6
    }
  },
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "engines": {
    "node": ">= 8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerbf/lsregister.git"
  },
  "bugs": {
    "url": "https://github.com/rogerbf/lsregister/issues"
  },
  "homepage": "https://github.com/rogerbf/lsregister#readme",
  "bin": {
    "lsregister-json": "./src/bin/cli.js"
  },
  "dependencies": {
    "mac-defaults": "^2.0.0"
  }
}
